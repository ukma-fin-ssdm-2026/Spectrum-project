@startuml
title Domain Model

skinparam shadowing false
hide methods
hide circle

package "Identity & Access Context" {
  class User <<aggregate root>> {
    UserId <<identity>>
    Name <<personal data>>
    Email <<personal data>>
    PasswordHash <<sensitive>>
    Role : CLIENT | WORKER | ADMIN
  }

  class PermissionGrant <<sensitive>> {
    PermissionGrantId <<identity>>
    RoomScope : AllRooms | set of RoomId
    BookingAccessLevel : APPROVE | CANCEL
    RoomManagementLevel : ADD | EDIT | REMOVE | ACTIVATE | DEACTIVATE
  }
}

package "Hotel Management Context" {
  class Hotel <<aggregate root>> {
    HotelId <<identity>>
    Name
    Address
  }

  class Room {
    RoomId <<identity>>
    RoomNumber
    RoomType : SINGLE | DOUBLE | SUITE
    PricePerNight : Money
    Status : ACTIVE | INACTIVE
  }
}

package "Booking Context" {
  class Booking <<aggregate root>> <<personal data>> {
    BookingId <<identity>>
    DateRange : CheckIn, CheckOut
    Status : PENDING | APPROVED | CANCELLED | COMPLETED
    CreatedAt
  }
}

User "1" *-- "0..*" PermissionGrant : granted to worker
PermissionGrant "0..*" --> "1" Hotel : scoped to
Hotel "1" *-- "0..*" Room : contains
Booking "0..*" --> "1" Room : reserves
Booking "0..*" --> "1" User : made by client

note bottom of User
  Invariant: no two users
  share the same email
end note

note bottom of PermissionGrant
  Invariant: BookingAccessLevel and
  RoomManagementLevel are not
  both empty
end note

note bottom of Room
  Invariants:
  RoomNumber is unique within a hotel;
  a room with PENDING or APPROVED
  bookings cannot be deleted
end note

note bottom of Booking
  Invariants:
  CheckOut > CheckIn;
  no two APPROVED bookings of one room
  overlap; the client must have
  Role = CLIENT
end note

legend right
  <<personal data>> identifies a person or their stay
  <<sensitive>> credentials or data that controls access
endlegend

caption **AI usage**: drafted with LLM from data-model.md
@enduml
